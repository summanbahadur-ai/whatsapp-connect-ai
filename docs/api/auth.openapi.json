{
  "openapi": "3.1.0",
  "info": {
    "title": "WhatsApp Connect AI - implemented Java auth endpoints",
    "version": "CP05",
    "description": "Implemented Java signup, login, CSRF, stored sessions, auth context and logout. Password recovery and interactive documentation UI remain later checkpoints. Signup does not auto-login. Anonymous/expired sessions return401."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin frontend transport to Java"
    }
  ],
  "paths": {
    "/api/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "summary": "Materialize a masked CSRF token and HttpOnly WC_CSRF cookie",
        "security": [],
        "responses": {
          "200": {
            "description": "No-store; send returned masked token/header on signup, login and logout.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "headerName"
                  ],
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "headerName": {
                      "type": "string",
                      "const": "X-XSRF-TOKEN"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-up/email": {
      "post": {
        "operationId": "signup",
        "summary": "Atomically create identity, credential and owner account/profile",
        "description": "Requires the CSRF cookie, returned masked token header, and an exactly allowed browser Origin. Ignores posted identity/account/role/verification claims. Name/email are trimmed and email is lowercased. No authenticated session is issued in CP04.",
        "security": [
          {
            "CsrfCookie": [],
            "CsrfHeader": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Configured frontend origin. Defaults: http://127.0.0.1:3001 or http://localhost:3001."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true,
                    "minLength": 8,
                    "maxLength": 72,
                    "description": "Unmodified password; additionally bounded to72 UTF-8 bytes to avoid BCrypt truncation."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; private/no-store. No login/session cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Safe error; rejected values and storage/credential details are never echoed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe error; rejected values and storage/credential details are never echoed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe error; rejected values and storage/credential details are never echoed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe error; rejected values and storage/credential details are never echoed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/email": {
      "post": {
        "operationId": "signin",
        "summary": "Authenticate credentials and replace any previous session",
        "security": [
          {
            "CsrfCookie": [],
            "CsrfHeader": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured browser origin, plus CSRF cookie/header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 1,
                    "maxLength": 72,
                    "description": "Never logged; at most72 UTF-8 bytes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "No-store. Sets a new WC_SESSION and clears WC_CSRF; fetch fresh CSRF before next write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthView"
                }
              }
            }
          },
          "400": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/get-session": {
      "get": {
        "operationId": "getSession",
        "summary": "Validate stored session and reload current account membership",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "No-store trusted user/profile/account. No session secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthView"
                }
              }
            }
          },
          "401": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth-context": {
      "get": {
        "operationId": "getAuthContext",
        "summary": "Validate stored session and reload current account membership",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "No-store trusted user/profile/account. No session secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthView"
                }
              }
            }
          },
          "401": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "signout",
        "summary": "Revoke current stored session and expire its cookie",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured browser origin, plus CSRF cookie/header."
          }
        ],
        "security": [
          {
            "SessionCookie": [],
            "CsrfCookie": [],
            "CsrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe validation/authentication/CSRF/storage error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CsrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "WC_CSRF",
        "description": "HttpOnly SameSite=Lax cookie set by GET /api/auth/csrf."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN",
        "description": "Masked token returned in the CSRF JSON response; do not read the HttpOnly cookie from JavaScript."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "WC_SESSION",
        "description": "HttpOnly, SameSite=Lax, Path=/; Secure on HTTPS. 30-minute idle and seven-day absolute lifetime. Never expose its value in JSON."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "email",
          "account_id",
          "account_role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "beta_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "agent",
              "viewer"
            ]
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "name",
          "default_currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "default_currency": {
            "type": "string"
          }
        }
      },
      "AuthView": {
        "type": "object",
        "required": [
          "user",
          "profile",
          "account"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        }
      }
    }
  }
}
